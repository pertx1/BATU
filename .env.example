# Base de datos PostgreSQL (Supabase o Neon).
# Supabase → Connect → "Transaction pooler" (puerto 6543), con tu contraseña real:
DATABASE_URL="postgresql://postgres.TU_REF:TU_CONTRASEÑA@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
# Opcional. Si falta, las migraciones usan el mismo pooler en modo sesión (puerto 5432).
# NO uses db.TU_REF.supabase.co: es solo IPv6 y Vercel no puede conectarse.
# DIRECT_URL="postgresql://postgres.TU_REF:TU_CONTRASEÑA@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# URL pública de la app, sin barra final
APP_URL="https://antola.vercel.app"

# Registro abierto (true) o cerrado (false)
ALLOW_SIGNUP="true"

# Email del administrador (único con acceso a /admin)
ADMIN_EMAIL="tu-email@ejemplo.com"

# Secreto del endpoint /api/cron/tick?key=...  (openssl rand -hex 32)
CRON_SECRET=""

# Notificaciones push. Genera las claves y el CRON_SECRET con: npm run secrets
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-email@ejemplo.com"

# Emails (Resend) para recuperar contraseña
RESEND_API_KEY=""
EMAIL_FROM="Antola <no-reply@tudominio.com>"
