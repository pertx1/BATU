# Base de datos (Neon). Runtime: URL con pooler (-pooler en el host). Migraciones: URL directa.
# En Vercel DIRECT_URL es opcional (si falta se usa DATABASE_URL_UNPOOLED o DATABASE_URL).
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://usuario:clave@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# URL pública de la app, sin barra final
APP_URL="https://antola.vercel.app"

# Registro abierto (true) o cerrado (false)
ALLOW_SIGNUP="true"

# Email del administrador (único con acceso a /admin)
ADMIN_EMAIL="tu-email@ejemplo.com"

# Secreto del endpoint /api/cron/tick?key=...  (openssl rand -hex 32)
CRON_SECRET=""

# Notificaciones push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-email@ejemplo.com"

# Emails (Resend) para recuperar contraseña
RESEND_API_KEY=""
EMAIL_FROM="Antola <no-reply@tudominio.com>"
